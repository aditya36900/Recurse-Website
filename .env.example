# Set to the final public origin before building (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://recursekmit.vercel.app

# Optional external JSON POST endpoint; leave empty to use the email workflow.
NEXT_PUBLIC_OPPORTUNITY_SUBMIT_URL=

# Ghost Process (server-only; never prefix with NEXT_PUBLIC_).
# Long random string used to derive each roll number's key. Changing it changes every key.
GHOST_SECRET=
# From @BotFather, and the chat/group id that should receive "cracked" alerts.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Upstash Redis REST credentials (set automatically when you connect
# "Upstash for Redis" from the Vercel Marketplace). Stores every player's key and solve.
KV_REST_API_URL=
KV_REST_API_TOKEN=
