{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recurse-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only API requests reach the Worker; pages and files are served straight from out/.
    "run_worker_first": ["/api/*"]
  },
  // Ghost Process players and progress (D1 database "recurse-ghost").
  "d1_databases": [
    {
      "binding": "GHOST_DB",
      "database_name": "recurse-ghost",
      "database_id": "e6afc328-e443-424b-8e7d-369dec0d5485"
    }
  ]
}
