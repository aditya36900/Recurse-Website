{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recurse-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Only API requests reach the Worker; pages and files are served straight from out/.
    "run_worker_first": ["/api/*"]
  },
  // Ghost Process players and progress. Create with `npx wrangler d1 create recurse-ghost`
  // and paste the printed database_id here.
  "d1_databases": [
    {
      "binding": "GHOST_DB",
      "database_name": "recurse-ghost",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
